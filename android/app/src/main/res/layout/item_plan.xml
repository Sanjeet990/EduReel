<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvPlanName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monthly Plan"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPlanPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="₹ 499 / month"
        android:textColor="#A08FFF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvPlanFeatures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="• Ad-free experience\n• Unlimited device access"
        android:textColor="@color/colorTextSecondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnBuyPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#836EF8"
        android:text="Buy Plan"
        android:textAllCaps="false"
        android:textColor="@android:color/white" />

</LinearLayout>
